---
import Panel from '../layouts/Panel.astro';
import { cola, informe, metricas28, comentarios } from '../lib/datos';
import { pendiente } from '../lib/pendiente';
import { n, corta, RED, miniatura, tituloDe, type Pub } from '../lib/util';

const [ps, inf, com, pend] = await Promise.all([cola(), informe(), comentarios(), pendiente(Astro.cookies)]);
const c28 = metricas28(inf);
const sem = inf?.resumen_semana || {};
const ahora = Date.now();
const semana = ps.filter((p) => ['pendiente', 'borrador', 'externa'].includes(p.estado) && Date.parse(p.fecha) >= ahora - 36e5 && Date.parse(p.fecha) < ahora + 7 * 864e5)
  .sort((a, b) => Date.parse(a.fecha) - Date.parse(b.fecha));
const redesDe = (l: Pub[]) => [...new Set(l.flatMap((p) => p.redes))];
const portada = (l: Pub[]) => miniatura(l.find((p) => p.tipo !== 'historia') || l[0]);
const nada = !pend.total && !pend.ideasNuevas;
---
<Panel titulo="Inicio" seccion="inicio">
  <section>
    <h2>Para ti</h2>
    {nada && <p class="vacio">Todo en orden. No hay nada que aprobar ni mensajes sin atender.</p>}
    <div class="lista">
      {pend.mensajes.map((a) => (
        <div class="fila">
          <span class="fila__tipo msg">{a.privado ? 'Privado' : 'Comentario'}</span>
          <span class="fila__txt"><b>{a.usuario}</b> <span class="meta">{a.red}</span><span class="fila__sub">«{a.texto}»</span></span>
          <span class="acciones">
            {a.enlace && <a class="boton boton--coral" href={a.enlace} target="_blank" rel="noopener">Contestar</a>}
            <form method="post" action="/api/accion"><input type="hidden" name="accion" value="aviso-hecho" /><input type="hidden" name="id" value={a.id} /><input type="hidden" name="volver" value="/" /><button class="boton">Hecho</button></form>
          </span>
        </div>
      ))}
      {pend.errores.map((p) => (
        <div class="fila">
          <span class="fila__tipo err">Error</span>
          <span class="fila__txt"><b>{tituloDe(p)}</b><span class="fila__sub">{p.error}</span></span>
          <span class="acciones">
            <form method="post" action="/api/accion"><input type="hidden" name="accion" value="reintentar" /><input type="hidden" name="id" value={p.id} /><input type="hidden" name="volver" value="/" /><button class="boton boton--coral">Reintentar</button></form>
            <a class="boton" href={`/publicaciones?ver=error#${p.id}`}>Revisar</a>
          </span>
        </div>
      ))}
      {pend.aprobar.map(({ piezas }) => {
        const m = portada(piezas);
        return (
          <div class="fila">
            {m && !m.video ? <img class="fila__img" src={m.url} alt="" /> : <span class="fila__tipo">{piezas[0].id.startsWith('n-') ? 'Noticia' : 'Aprobar'}</span>}
            <span class="fila__txt"><b>{tituloDe(piezas[0])}</b><span class="fila__sub">{corta(piezas[0].fecha)} {redesDe(piezas).map((r) => <span class={`red ${r}`}>{RED[r]}</span>)}{piezas.length > 1 && ` · ${piezas.length} piezas`}</span></span>
            <span class="acciones">
              <form method="post" action="/api/accion"><input type="hidden" name="accion" value="aprobar" /><input type="hidden" name="id" value={piezas.map((p) => p.id).join(',')} /><input type="hidden" name="volver" value="/" /><button class="boton boton--coral">Aprobar</button></form>
              <a class="boton" href={`/publicaciones?ver=aprobar#${piezas[0].id}`}>Revisar</a>
            </span>
          </div>
        );
      })}
      {pend.ideasNuevas > 0 && (
        <div class="fila">
          <span class="fila__tipo">Ideas</span>
          <span class="fila__txt"><b>{pend.ideasNuevas === 1 ? 'Hay 1 idea nueva' : `Hay ${pend.ideasNuevas} ideas nuevas`}</b></span>
          <span class="acciones"><a class="boton" href="/ideas?estado=idea">Ver</a></span>
        </div>
      )}
    </div>
  </section>

  <section>
    <h2>Instagram, últimos 28 días</h2>
    <div class="kpis">
      <div class="kpi"><b>{n(inf?.instagram_cuenta?.followers_count)}</b><span>Seguidores</span></div>
      <div class="kpi"><b>{n(c28.reach)}</b><span>Alcance</span></div>
      <div class="kpi destaca"><b>{n(sem.compartidos_mas_guardados_total)}</b><span>Compartidos y guardados (7 días)</span></div>
      <div class="kpi"><b>{n(c28.website_clicks)}</b><span>Clics a la web</span></div>
    </div>
  </section>

  <section>
    <h2>Próximos 7 días</h2>
    {semana.length ? (
      <ul class="semana">
        {semana.map((p) => <li><a href={`/publicaciones?ver=${p.estado === 'borrador' ? 'aprobar' : 'programadas'}#${p.id}`}><span class="semana__dia">{corta(p.fecha)}</span><span class="semana__redes">{p.redes.map((r) => <span class={`red ${r}`}>{RED[r]}</span>)}</span><span class="semana__t">{tituloDe(p)}</span>{p.estado === 'borrador' && <span class="chip borrador">por aprobar</span>}</a></li>)}
      </ul>
    ) : <p class="vacio">No hay nada programado esta semana.</p>}
  </section>

  {com?.errores?.length > 0 && <p class="meta">Revisión de comentarios con fallos: {com.errores.join(' · ')}</p>}
</Panel>

<style>
  .lista { display: grid; gap: 8px; }
  .fila { display: grid; grid-template-columns: 56px minmax(0, 1fr) auto; gap: 14px; align-items: center; padding: 10px 12px; background: var(--capa); border: 1px solid var(--linea); border-radius: 8px; }
  .fila__img { width: 44px; height: 55px; object-fit: cover; border-radius: 4px; }
  .fila__tipo { font-family: var(--mono); font-size: 10px; letter-spacing: .06em; text-transform: uppercase; color: var(--aviso); }
  .fila__tipo.msg { color: var(--coral); } .fila__tipo.err { color: var(--error); }
  .fila__txt { display: grid; gap: 2px; min-width: 0; }
  .fila__txt b { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fila__sub { font-size: 13px; color: var(--gris); display: flex; gap: 6px; align-items: center; flex-wrap: wrap; overflow-wrap: anywhere; }
  .semana { list-style: none; margin: 0; padding: 0; border: 1px solid var(--linea); border-radius: 8px; }
  .semana li + li { border-top: 1px solid var(--linea); }
  .semana a { display: grid; grid-template-columns: 150px 56px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 10px 14px; text-decoration: none; }
  .semana a:hover { background: var(--capa); }
  .semana__dia { font-family: var(--mono); font-size: 12px; color: var(--gris); }
  .semana__redes { display: flex; gap: 4px; }
  .semana__t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  @media (max-width: 640px) {
    .fila { grid-template-columns: minmax(0, 1fr); } .fila__img, .fila__tipo { display: none; }
    .semana a { grid-template-columns: auto minmax(0, 1fr); } .semana__dia { grid-column: 1 / -1; }
  }
</style>
