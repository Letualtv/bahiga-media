---
import Panel from '../layouts/Panel.astro';
import Pieza from '../components/Pieza.astro';
import { cola } from '../lib/datos';

const ps = await cola();
const PEST = [
  ['programadas', 'Programadas', (p: any) => p.estado === 'pendiente'],
  ['aprobar', 'Por aprobar', (p: any) => p.estado === 'borrador'],
  ['publicadas', 'Publicadas', (p: any) => p.estado === 'publicada'],
  ['error', 'Con error', (p: any) => p.estado === 'error'],
  ['descartadas', 'Descartadas', (p: any) => p.estado === 'descartada'],
] as const;
const tab = Astro.url.searchParams.get('ver') || 'programadas';
const red = Astro.url.searchParams.get('red') || '';
const actual = PEST.find((t) => t[0] === tab) || PEST[0];
const filtro = (p: any) => !red || (red === 'noticias' ? p.id.startsWith('n-') : p.redes.includes(red));
let lista = ps.filter(actual[2]).filter(filtro);
lista = lista.sort((a, b) => (tab === 'publicadas' || tab === 'descartadas' ? Date.parse(b.fecha) - Date.parse(a.fecha) : Date.parse(a.fecha) - Date.parse(b.fecha)));
const volver = `/publicaciones?ver=${tab}${red ? `&red=${red}` : ''}`;
---
<Panel titulo="Publicaciones" seccion="publicaciones">
  <div class="filtros">
    <nav class="pestanas" aria-label="Estado">
      {PEST.map(([k, t, f]) => { const c = ps.filter(f).filter(filtro).length; return (k === tab || c > 0) && <a href={`/publicaciones?ver=${k}${red ? `&red=${red}` : ''}`} aria-current={k === tab ? 'page' : undefined}>{t}<span>{c}</span></a>; })}
    </nav>
    <form method="get" class="red-sel">
      <input type="hidden" name="ver" value={tab} />
      <select name="red" aria-label="Red" onchange="this.form.submit()">
        {[['', 'Todas las redes'], ['instagram', 'Instagram'], ['facebook', 'Facebook'], ['linkedin', 'LinkedIn'], ['noticias', 'Solo noticias']].map(([k, t]) => <option value={k} selected={k === red}>{t}</option>)}
      </select>
    </form>
  </div>
  <section>{lista.length ? lista.map((p) => <Pieza p={p} volver={volver} />) : <p class="vacio">No hay nada aquí.</p>}</section>
</Panel>
<style>
  .filtros { display: flex; flex-wrap: wrap; gap: 12px; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--linea); padding-bottom: 10px; }
  .filtros .pestanas { border: 0; padding: 0; }
</style>
