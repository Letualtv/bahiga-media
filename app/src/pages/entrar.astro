---
import { COOKIE, crearSesion, claveCorrecta, bloqueado, anotarFallo, sesionValida } from '../lib/sesion';

if (sesionValida(Astro.cookies.get(COOKIE)?.value)) return Astro.redirect('/');
let error = '';
if (Astro.request.method === 'POST') {
  const ip = Astro.request.headers.get('x-real-ip') || Astro.clientAddress || '?';
  if (bloqueado(ip)) error = 'Demasiados intentos. Prueba dentro de 15 minutos.';
  else {
    const f = await Astro.request.formData();
    if (claveCorrecta(String(f.get('clave') || ''))) {
      Astro.cookies.set(COOKIE, crearSesion(), { httpOnly: true, secure: Astro.request.headers.get('x-forwarded-proto') === 'https', sameSite: 'lax', path: '/', maxAge: 30 * 86400 });
      return Astro.redirect('/');
    }
    anotarFallo(ip);
    error = 'Contraseña incorrecta.';
  }
}
---
<!doctype html>
<html lang="es">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex, nofollow" /><title>Entrar · Bahiga</title><link rel="icon" href="/arco.svg" /></head>
<body>
  <main>
    <img src="/arco.svg" alt="" />
    <h1>Bahiga<i>.</i></h1>
    <p>Panel de contenido</p>
    <form method="post">
      <label for="clave">Contraseña</label>
      <input id="clave" name="clave" type="password" autocomplete="current-password" required autofocus />
      <button type="submit">Entrar</button>
      {error && <p class="error" role="alert">{error}</p>}
    </form>
  </main>
</body>
</html>
<style is:global>
  @font-face { font-family: "BD"; src: url(/fuentes/display.woff2) format("woff2"); }
  @font-face { font-family: "BU"; src: url(/fuentes/ui.woff2) format("woff2"); }
  html, body { margin: 0; min-height: 100%; background: #0F1C24; color: #FAF8F5; font-family: "BU", system-ui, sans-serif; color-scheme: dark; }
  main { min-height: 100vh; display: grid; place-content: center; justify-items: center; gap: 6px; padding: 24px; }
  img { height: 56px; } h1 { margin: 6px 0 0; font-family: "BD", Georgia, serif; font-weight: 400; font-size: 40px; } h1 i { color: #E8683C; font-style: normal; }
  main > p { margin: 0 0 20px; color: #A9B4BA; font-size: 13px; letter-spacing: .1em; text-transform: uppercase; }
  form { display: grid; gap: 8px; width: min(320px, 90vw); }
  label { font-size: 13px; color: #A9B4BA; }
  input { font: inherit; padding: 10px 12px; border-radius: 6px; border: 1px solid #24343E; background: #14242E; color: #FAF8F5; }
  button { font: inherit; font-weight: 600; padding: 10px; border: 0; border-radius: 6px; background: #E8683C; color: #0F1C24; cursor: pointer; }
  .error { color: #F08A7E; margin: 4px 0 0; }
</style>
