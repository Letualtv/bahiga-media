---
/* Una publicación en una línea. Al pulsarla se abre el texto y el resto de opciones. */
import { type Pub, TIPO, RED, corta, miniatura, textoDe, tituloDe, enlaceDe, aLocal } from '../lib/util';
interface Props { p: Pub; volver: string }
const { p, volver } = Astro.props;
const mini = miniatura(p);
const texto = textoDe(p);
const enlace = enlaceDe(p);
const oc = { accion: '', id: p.id, volver };
---
<article class="pieza" id={p.id}>
  <details>
    <summary class="pieza__fila">
      {mini ? (mini.video
        ? <video class="pmini" src={`${mini.url}#t=1`} muted preload="metadata" playsinline></video>
        : <img class="pmini" src={mini.url} alt="" loading="lazy" />)
        : <span class="pmini"></span>}
      <span class="pieza__info">
        <span class="pieza__meta">{corta(p.fecha)} {p.redes.map((r) => <span class={`red ${r}`}>{RED[r] || r}</span>)} <span class="meta">{TIPO[p.tipo] || p.tipo}</span></span>
        <span class="pieza__titulo">{tituloDe(p)}</span>
        {p.error && <span class="pieza__error">{p.error}</span>}
      </span>
    </summary>
    <div class="pieza__detalle">
      {texto && <pre class="pieza__texto">{texto}</pre>}
      {p.texto_linkedin && p.texto && <><p class="meta">Texto de LinkedIn</p><pre class="pieza__texto">{p.texto_linkedin}</pre></>}
      {p.primer_comentario && <><p class="meta">Primer comentario</p><pre class="pieza__texto">{p.primer_comentario}</pre></>}
      <div class="acciones">
        {['pendiente', 'borrador', 'error'].includes(p.estado) && (
          <form method="post" action="/api/accion" class="hora"><input type="hidden" name="accion" value="hora" /><input type="hidden" name="id" value={p.id} /><input type="hidden" name="volver" value={volver} />
            <input type="datetime-local" name="fecha" value={aLocal(p.fecha)} aria-label="Nueva fecha" required /><button class="boton">Cambiar hora</button></form>
        )}
        {p.estado !== 'publicada' && p.estado !== 'descartada' && <form method="post" action="/api/accion"><input type="hidden" name="accion" value="ahora" /><input type="hidden" name="id" value={p.id} /><input type="hidden" name="volver" value={volver} /><button class="boton">Publicar ahora</button></form>}
        {p.estado === 'pendiente' && <form method="post" action="/api/accion"><input type="hidden" name="accion" value="pausar" /><input type="hidden" name="id" value={p.id} /><input type="hidden" name="volver" value={volver} /><button class="boton">Pausar</button></form>}
        {['borrador', 'pendiente', 'error'].includes(p.estado) && <form method="post" action="/api/accion"><input type="hidden" name="accion" value="descartar" /><input type="hidden" name="id" value={p.id} /><input type="hidden" name="volver" value={volver} /><button class="boton boton--peligro">Descartar</button></form>}
      </div>
    </div>
  </details>
  <div class="pieza__principal">
    {p.estado === 'borrador' && <form method="post" action="/api/accion"><input type="hidden" name="accion" value="aprobar" /><input type="hidden" name="id" value={p.id} /><input type="hidden" name="volver" value={volver} /><button class="boton boton--coral">Aprobar</button></form>}
    {p.estado === 'error' && <form method="post" action="/api/accion"><input type="hidden" name="accion" value="reintentar" /><input type="hidden" name="id" value={p.id} /><input type="hidden" name="volver" value={volver} /><button class="boton boton--coral">Reintentar</button></form>}
    {enlace && <a class="boton" href={enlace} target="_blank" rel="noopener">Ver</a>}
  </div>
</article>

<style>
  .pieza { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px; align-items: start; padding: 10px 0; border-top: 1px solid var(--linea); }
  .pieza:first-child { border-top: 0; }
  summary { list-style: none; cursor: pointer; } summary::-webkit-details-marker { display: none; }
  .pieza__fila { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 12px; align-items: center; }
  .pmini { width: 44px; height: 55px; object-fit: cover; border-radius: 4px; background: var(--capa2); display: block; }
  .pieza__info { display: grid; gap: 2px; min-width: 0; }
  .pieza__meta { display: flex; gap: 6px; align-items: center; font-size: 12px; color: var(--gris); flex-wrap: wrap; }
  .pieza__titulo { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  details[open] .pieza__titulo { white-space: normal; }
  .pieza__error { color: var(--error); font-size: 12px; overflow-wrap: anywhere; }
  .pieza__detalle { display: grid; gap: 8px; padding: 10px 0 4px 56px; }
  .pieza__texto { white-space: pre-wrap; font-family: var(--ui); font-size: 13px; line-height: 1.55; background: var(--capa); border: 1px solid var(--linea); border-radius: 6px; padding: 10px 12px; margin: 0; overflow-wrap: anywhere; }
  .pieza__detalle .meta { margin: 0; }
  .pieza__principal { display: flex; gap: 6px; padding-top: 10px; }
  .pieza__principal form { display: contents; }
  .hora { display: flex !important; gap: 6px; align-items: center; flex-wrap: wrap; }
  @media (max-width: 560px) { .pieza__detalle { padding-left: 0; } }
</style>
