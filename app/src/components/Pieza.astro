---
/* Una publicación de la cola con su vista previa, su texto y las acciones que admite su estado. */
import { type Pub, TIPO, ESTADO, corta, miniatura, textoDe, enlaceDe, aLocal } from '../lib/util';
interface Props { p: Pub; volver: string; abierta?: boolean }
const { p, volver, abierta = false } = Astro.props;
const mini = miniatura(p);
const texto = textoDe(p);
const enlace = enlaceDe(p);
---
<article class="pieza">
  {mini ? (mini.video
    ? <video class="mini" src={`${mini.url}#t=1`} muted preload="metadata" playsinline></video>
    : <img class="mini" src={mini.url} alt="" loading="lazy" />)
    : <div class="mini"></div>}
  <div class="pieza__txt">
    <p class="pieza__cab"><strong>{corta(p.fecha)}</strong> <span class="meta">{p.id}</span></p>
    <div class="chips">
      {p.redes.map((r) => <span class={`chip ${r}`}>{r}</span>)}
      <span class="chip">{TIPO[p.tipo] || p.tipo}</span>
      <span class={`chip ${p.estado}`}>{ESTADO[p.estado] || p.estado}</span>
      {p.musica && <span class="chip">música{p.musica.elegida ? `: ${p.musica.elegida}` : p.musica.buscar ? ` (${p.musica.buscar})` : ''}</span>}
    </div>
    {p.error && <p class="pieza__error">{p.error}</p>}
    <details open={abierta}>
      <summary>{(texto.split('\n')[0] || '(sin texto: historia)').slice(0, 140)}</summary>
      {texto && <pre class="pieza__texto">{texto}</pre>}
      {p.texto_linkedin && p.texto && <><p class="meta">Texto de LinkedIn</p><pre class="pieza__texto">{p.texto_linkedin}</pre></>}
      {p.primer_comentario && <><p class="meta">Primer comentario</p><pre class="pieza__texto">{p.primer_comentario}</pre></>}
    </details>
    <div class="acciones">
      {p.estado === 'borrador' && <>
        <form method="post" action="/api/accion"><input type="hidden" name="accion" value="aprobar" /><input type="hidden" name="id" value={p.id} /><input type="hidden" name="volver" value={volver} /><button class="boton boton--coral">Aprobar</button></form>
        <form method="post" action="/api/accion"><input type="hidden" name="accion" value="ahora" /><input type="hidden" name="id" value={p.id} /><input type="hidden" name="volver" value={volver} /><button class="boton">Publicar ahora</button></form>
        <form method="post" action="/api/accion"><input type="hidden" name="accion" value="descartar" /><input type="hidden" name="id" value={p.id} /><input type="hidden" name="volver" value={volver} /><button class="boton boton--peligro">Descartar</button></form>
      </>}
      {p.estado === 'pendiente' && <form method="post" action="/api/accion"><input type="hidden" name="accion" value="pausar" /><input type="hidden" name="id" value={p.id} /><input type="hidden" name="volver" value={volver} /><button class="boton">Pasar a borrador</button></form>}
      {p.estado === 'error' && <form method="post" action="/api/accion"><input type="hidden" name="accion" value="reintentar" /><input type="hidden" name="id" value={p.id} /><input type="hidden" name="volver" value={volver} /><button class="boton boton--coral">Reintentar</button></form>}
      {['pendiente', 'borrador', 'error'].includes(p.estado) && (
        <form method="post" action="/api/accion" class="hora"><input type="hidden" name="accion" value="hora" /><input type="hidden" name="id" value={p.id} /><input type="hidden" name="volver" value={volver} />
          <input type="datetime-local" name="fecha" value={aLocal(p.fecha)} aria-label={`Nueva fecha para ${p.id}`} required /><button class="boton">Cambiar hora</button></form>
      )}
      {enlace && <a class="boton" href={enlace} target="_blank" rel="noopener">Ver publicada</a>}
    </div>
  </div>
</article>

<style>
  .pieza { display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: 14px; padding: 14px 0; border-top: 1px solid var(--linea); }
  .pieza__txt { display: grid; gap: 8px; min-width: 0; }
  .pieza__cab { margin: 0; display: flex; gap: 10px; flex-wrap: wrap; align-items: baseline; }
  .pieza__error { margin: 0; color: var(--error); font-size: 13px; overflow-wrap: anywhere; }
  details summary { cursor: pointer; color: var(--gris); font-size: 13px; }
  .pieza__texto { white-space: pre-wrap; font-family: var(--ui); font-size: 13px; line-height: 1.55; background: var(--tinta); border: 1px solid var(--linea); border-radius: 6px; padding: 10px 12px; margin: 8px 0; overflow-wrap: anywhere; }
  .hora { display: flex !important; gap: 6px; align-items: center; }
</style>
