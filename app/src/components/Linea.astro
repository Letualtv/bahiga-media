---
/* Gráfico de línea en SVG, dibujado en servidor. Una sola escala para línea, puntos y etiquetas. */
interface Props { puntos: { x: string; y: number | null }[]; titulo: string; color?: string }
const { puntos, titulo, color = 'var(--coral)' } = Astro.props;
const W = 640, H = 200, M = { t: 16, r: 16, b: 28, l: 48 };
const val = puntos.filter((p) => p.y != null) as { x: string; y: number }[];
const max = Math.max(1, ...val.map((p) => p.y)), min = Math.min(0, ...val.map((p) => p.y));
const techo = max === min ? max + 1 : max + (max - min) * 0.1;
const X = (i: number) => M.l + (val.length <= 1 ? (W - M.l - M.r) / 2 : (i * (W - M.l - M.r)) / (val.length - 1));
const Y = (v: number) => M.t + (H - M.t - M.b) * (1 - (v - min) / (techo - min));
const d = val.map((p, i) => `${i ? 'L' : 'M'}${X(i).toFixed(1)},${Y(p.y).toFixed(1)}`).join(' ');
const area = val.length ? `${d} L${X(val.length - 1).toFixed(1)},${Y(min)} L${X(0).toFixed(1)},${Y(min)} Z` : '';
const marcas = [min, (min + techo) / 2, techo].map((v) => Math.round(v));
const etiquetas = val.length > 6 ? [0, Math.floor((val.length - 1) / 2), val.length - 1] : val.map((_, i) => i);
const fx = (s: string) => new Date(s + 'T12:00:00Z').toLocaleDateString('es-ES', { day: 'numeric', month: 'short' });
---
<figure class="graf">
  <figcaption>{titulo} {val.length ? <b>{val[val.length - 1].y.toLocaleString('es-ES')}</b> : null}</figcaption>
  {val.length < 2
    ? <p class="vacio">Hace falta al menos dos días de datos para dibujar la evolución. Se completa solo cada mañana.</p>
    : <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={titulo}>
        {marcas.map((v) => <g><line x1={M.l} x2={W - M.r} y1={Y(v)} y2={Y(v)} stroke="var(--linea)" /><text x={M.l - 8} y={Y(v) + 4} text-anchor="end" fill="var(--gris)" font-size="11">{v.toLocaleString('es-ES')}</text></g>)}
        <path d={area} fill={color} fill-opacity="0.12" />
        <path d={d} fill="none" stroke={color} stroke-width="2.5" stroke-linejoin="round" />
        <circle cx={X(val.length - 1)} cy={Y(val[val.length - 1].y)} r="4" fill={color} />
        {etiquetas.map((i) => <text x={X(i)} y={H - 8} text-anchor="middle" fill="var(--gris)" font-size="11">{fx(val[i].x)}</text>)}
      </svg>}
</figure>
<style>
  .graf { margin: 0; background: var(--capa); border: 1px solid var(--linea); border-radius: 8px; padding: 14px; display: grid; gap: 8px; }
  figcaption { font-size: 13px; color: var(--gris); display: flex; justify-content: space-between; }
  figcaption b { font-family: var(--display); font-weight: 400; font-size: 22px; color: var(--hueso); }
  svg { width: 100%; height: auto; display: block; }
</style>
