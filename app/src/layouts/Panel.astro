---
interface Props { titulo: string; seccion: string }
const { titulo, seccion } = Astro.props;
const NAV = [
  ['inicio', '/', 'Inicio'],
  ['publicaciones', '/publicaciones', 'Publicaciones'],
  ['calendario', '/calendario', 'Calendario'],
  ['analisis', '/analisis', 'Análisis'],
  ['competencia', '/competencia', 'Competencia'],
  ['noticias', '/noticias', 'Noticias'],
  ['ideas', '/ideas', 'Ideas'],
];
const aviso = Astro.url.searchParams.get('ok') || Astro.url.searchParams.get('error');
const esError = Astro.url.searchParams.has('error');
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{titulo} · Bahiga</title>
  <link rel="icon" href="/arco.svg" />
</head>
<body>
  <aside class="lateral">
    <a href="/" class="marca"><img src="/arco.svg" alt="" /><span>Bahiga<i>.</i></span></a>
    <p class="marca__sub">Panel de contenido</p>
    <nav aria-label="Secciones">
      {NAV.map(([k, h, t]) => <a href={h} aria-current={k === seccion ? 'page' : undefined}>{t}</a>)}
    </nav>
    <form method="post" action="/salir" class="salir"><button type="submit">Salir</button></form>
  </aside>
  <main class="contenido">
    <header class="cab"><h1>{titulo}</h1><slot name="cab" /></header>
    {aviso && <p class={`aviso ${esError ? 'aviso--error' : ''}`} role="status">{aviso}</p>}
    <slot />
  </main>
</body>
</html>

<style is:global>
  @font-face { font-family: "BD"; src: url(/fuentes/display.woff2) format("woff2"); font-display: swap; }
  @font-face { font-family: "BD"; font-style: italic; src: url(/fuentes/display-italic.woff2) format("woff2"); font-display: swap; }
  @font-face { font-family: "BU"; src: url(/fuentes/ui.woff2) format("woff2"); font-display: swap; }
  @font-face { font-family: "BU"; font-weight: 600; src: url(/fuentes/ui-600.woff2) format("woff2"); font-display: swap; }
  @font-face { font-family: "BM"; src: url(/fuentes/mono.woff2) format("woff2"); font-display: swap; }
  :root {
    --tinta: #0F1C24; --capa: #14242E; --capa2: #1A2E3A; --linea: #24343E; --hueso: #FAF8F5; --gris: #A9B4BA;
    --coral: #E8683C; --coral-s: #3A2A22; --ok: #7CC4A0; --aviso: #F0C36A; --error: #F08A7E;
    --ig: #F5A3C4; --fb: #9DB8F5; --li: #8FCBF0;
    --display: "BD", Georgia, serif; --ui: "BU", system-ui, sans-serif; --mono: "BM", ui-monospace, monospace;
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; background: var(--tinta); color: var(--hueso); font-family: var(--ui); font-size: 15px; line-height: 1.5; }
  body { display: grid; grid-template-columns: 230px minmax(0, 1fr); min-height: 100vh; }
  a { color: inherit; }
  .lateral { position: sticky; top: 0; height: 100vh; border-right: 1px solid var(--linea); padding: 22px 16px; display: flex; flex-direction: column; gap: 6px; background: var(--tinta); }
  .marca { display: flex; align-items: center; gap: 10px; text-decoration: none; font-family: var(--display); font-size: 26px; }
  .marca img { height: 30px; } .marca i { color: var(--coral); font-style: normal; }
  .marca__sub { margin: 0 0 18px 2px; font-family: var(--mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--gris); }
  nav { display: grid; gap: 2px; }
  nav a { text-decoration: none; padding: 9px 12px; border-radius: 6px; color: var(--gris); }
  nav a:hover { background: var(--capa); color: var(--hueso); }
  nav a[aria-current="page"] { background: var(--capa2); color: var(--hueso); box-shadow: inset 3px 0 0 var(--coral); }
  .salir { margin-top: auto; } .salir button { background: none; border: 1px solid var(--linea); color: var(--gris); padding: 8px 12px; border-radius: 6px; cursor: pointer; font: inherit; width: 100%; }
  .contenido { padding: 26px max(16px, 3vw) 64px; display: grid; gap: 28px; align-content: start; min-width: 0; }
  .cab { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px; }
  h1 { margin: 0; font-family: var(--display); font-weight: 400; font-size: 34px; letter-spacing: -.01em; }
  h2 { margin: 0 0 12px; font-family: var(--display); font-weight: 400; font-size: 22px; }
  h2 small, .meta { font-family: var(--mono); font-size: 12px; color: var(--gris); font-weight: 400; }
  .aviso { margin: 0; padding: 10px 14px; background: #1E3A2F; border-left: 3px solid var(--ok); }
  .aviso--error { background: #3A2422; border-left-color: var(--error); }
  .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1px; background: var(--linea); border: 1px solid var(--linea); }
  .kpi { background: var(--tinta); padding: 16px 18px; display: grid; gap: 4px; }
  .kpi b { font-family: var(--display); font-weight: 400; font-size: 36px; line-height: 1; font-variant-numeric: tabular-nums; }
  .kpi span { font-size: 12px; color: var(--gris); } .kpi.destaca b { color: var(--coral); }
  .tarjeta { background: var(--capa); border: 1px solid var(--linea); border-radius: 8px; padding: 16px; }
  .chip { font-family: var(--mono); font-size: 11px; padding: 2px 8px; border-radius: 99px; border: 1px solid var(--linea); color: var(--gris); white-space: nowrap; display: inline-block; }
  .chip.instagram { color: var(--ig); border-color: #5A3346; } .chip.facebook { color: var(--fb); border-color: #33415A; } .chip.linkedin { color: var(--li); border-color: #2D4656; }
  .chip.borrador { color: var(--aviso); border-color: #5A4A2A; } .chip.pendiente { color: var(--ok); border-color: #2E4A3D; } .chip.error { color: var(--error); border-color: #5A2F2B; } .chip.publicada { color: var(--hueso); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .boton { display: inline-flex; align-items: center; gap: 6px; min-height: 36px; padding: 7px 14px; border-radius: 6px; border: 1px solid var(--linea); background: var(--capa2); color: var(--hueso); font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; text-decoration: none; }
  .boton:hover { border-color: var(--gris); }
  .boton--coral { background: var(--coral); color: var(--tinta); border-color: var(--coral); }
  .boton--peligro { color: var(--error); }
  .acciones { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .acciones form { display: contents; }
  input, select, textarea { font: inherit; color: var(--hueso); background: var(--tinta); border: 1px solid var(--linea); border-radius: 6px; padding: 7px 10px; min-height: 36px; }
  textarea { width: 100%; min-height: 90px; resize: vertical; }
  label { font-size: 13px; color: var(--gris); display: grid; gap: 4px; }
  .vacio { color: var(--gris); margin: 0; }
  .tabla { overflow-x: auto; border: 1px solid var(--linea); border-radius: 8px; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; min-width: 760px; }
  th, td { padding: 10px 12px; text-align: left; border-bottom: 1px solid var(--linea); vertical-align: top; }
  th { font-family: var(--mono); font-weight: 400; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--gris); }
  td.n { text-align: right; font-variant-numeric: tabular-nums; font-family: var(--mono); }
  .pestanas { display: flex; flex-wrap: wrap; gap: 6px; border-bottom: 1px solid var(--linea); padding-bottom: 10px; }
  .pestanas a { text-decoration: none; padding: 6px 12px; border-radius: 99px; color: var(--gris); border: 1px solid transparent; }
  .pestanas a[aria-current="page"] { color: var(--hueso); border-color: var(--linea); background: var(--capa); }
  .pestanas a span { font-family: var(--mono); font-size: 11px; margin-left: 4px; }
  .mini { width: 72px; aspect-ratio: 4/5; object-fit: cover; border-radius: 4px; border: 1px solid var(--linea); background: var(--capa2); display: block; }
  :focus-visible { outline: 2px solid var(--hueso); outline-offset: 2px; }
  @media (max-width: 860px) {
    body { grid-template-columns: minmax(0, 1fr); }
    .lateral { position: static; height: auto; flex-direction: row; flex-wrap: wrap; align-items: center; border-right: 0; border-bottom: 1px solid var(--linea); padding: 12px 16px; }
    .marca__sub, .salir { display: none; }
    nav { display: flex; overflow-x: auto; gap: 4px; width: 100%; }
    nav a { white-space: nowrap; }
  }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>
